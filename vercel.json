{
  "version": 2,
  "regions": ["bom1"],
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "index.js": {
      "includeFiles": "frontend/dist/**"
    }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://stream.chimneysolutions.info/api/$1"
    },
    {
      "source": "/w/(.*)",
      "destination": "https://stream.chimneysolutions.info/w/$1"
    },
    {
      "source": "/((?!api/|w/|assets/|card/|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
